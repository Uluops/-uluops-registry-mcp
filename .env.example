# Required: Registry API base URL
ULUOPS_REGISTRY_URL=http://localhost:3001/api/v1

# Required: API key for authentication
ULUOPS_API_KEY=your-api-key-here

# Optional: Request timeout in milliseconds (default: 30000)
# ULUOPS_REGISTRY_TIMEOUT=30000

# Optional: Retry attempts for transient errors (default: 3)
# ULUOPS_REGISTRY_RETRIES=3

# Optional: Log level (debug, info, warn, error) — default: info
# LOG_LEVEL=info

# Optional: Enable file-based logging — default: false
# ENABLE_FILE_LOGGING=false

# Optional: Log directory — default: ./logs
# LOG_DIR=./logs

# Optional: Enable verbose security decision logging — default: false
# VERBOSE_LOGGING=false

# Optional: Enable performance metric logging — default: false
# LOG_PERFORMANCE_METRICS=false
