{
  "name": "@uluops/registry-mcp",
  "version": "0.3.5",
  "description": "MCP server for the UluOps Registry API — definition management, versioning, and analytics",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "uluops-registry-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tool-policies.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "chmod +x dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm test && npm audit --audit-level=high --omit=dev && npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "uluops",
    "registry",
    "definitions",
    "claude",
    "claude-code",
    "model-context-protocol"
  ],
  "author": "aself101",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uluops/-uluops-registry-mcp.git"
  },
  "homepage": "https://github.com/Uluops/-uluops-registry-mcp#readme",
  "bugs": {
    "url": "https://github.com/Uluops/-uluops-registry-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@uluops/registry-sdk": "0.45.0",
    "@uluops/sdk-core": "0.15.0",
    "mcp-secure-server": "0.0.19-security",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.19.11",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "4.1.8"
  },
  "overrides": {
    "hono": "4.12.25"
  }
}
