{
  "name": "uluops-registry-mcp-client",
  "version": "1.2.0",
  "description": "MCP client for UluOps Registry API - thin protocol adapter for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "uluops-registry-client": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "chmod +x dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "uluops-registry",
    "claude",
    "claude-code",
    "protocol-adapter"
  ],
  "author": "aself101",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uluops/-uluops-registry-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@uluops/definition-factory": "^0.33.0",
    "@uluops/registry-sdk": "file:../packages/-uluops-registry-sdk",
    "@uluops/sdk-core": "^0.6.0",
    "mcp-secure-server": "^0.0.14-security",
    "zod": "^3.23.0"
  },
  "overrides": {
    "mcp-secure-server": {
      "minimatch": ">=10.2.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.52.0",
    "vitest": "^2.1.0"
  }
}
